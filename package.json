{
  "name": "hellog-firebase",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.15.0" },
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "test": "node --test tests/firebaseRepository.test.js",
    "test:rules": "firebase emulators:exec --project demo-hellog --only firestore 'node --test tests/firestore.rules.test.js'",
    "test:firebase": "firebase emulators:exec --project demo-hellog --only auth,firestore 'node --test tests/firestore.rules.test.js tests/firebaseRepository.emulator.test.js'",
    "emulators": "firebase emulators:start --project demo-hellog",
    "deploy": "firebase deploy --only hosting,firestore:rules,firestore:indexes"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase-tools": "15.33.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  }
}
